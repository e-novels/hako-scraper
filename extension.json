{
  "name": "hako-scraper",
  "displayName": "Hako",
  "publisher": "hako",
  "version": "0.1.0",
  "description": "Search and read books from Hako.",
  "starter": {
    "kind": "scraper"
  },
  "engines": {
    "enovel": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "browser": "./dist/browser.js",
  "icon": "./public/icon.png",
  "activationEvents": [
    "always"
  ],
  "categories": [
    "Scrapers"
  ],
  "keywords": [
    "e-novels",
    "scraper",
    "typescript"
  ],
  "permissions": [
    "network",
    "reader",
    "storage"
  ],
  "network": {
    "allowedHosts": [
      "docln.sbs",
      "docln.net",
      "i.docln.net",
      "i1.docln.net",
      "i2.docln.net",
      "i3.docln.net",
      "i.hako.vip",
      "i1.hako.vip",
      "i2.hako.vip",
      "i3.hako.vip",
      "ln.hako.vip",
      "c1.hako.vip",
      "cdn.docln.net",
      "images.weserv.nl"
    ]
  },
  "contributes": {
    "settings": {
      "fields": [
        {
          "id": "email",
          "type": "text",
          "label": "Email / Tên tài khoản Hako",
          "placeholder": "user@example.com"
        },
        {
          "id": "password",
          "type": "password",
          "label": "Mật khẩu Hako",
          "placeholder": "••••••••"
        }
      ],
      "actions": [
        {
          "id": "loginAndCheckConnection",
          "label": "Đăng nhập & Kiểm tra kết nối",
          "fields": [
            "email",
            "password"
          ],
          "style": "primary"
        },
        {
          "id": "checkConnectionAction",
          "label": "Kiểm tra đăng nhập",
          "style": "default"
        },
        {
          "id": "clearSession",
          "label": "Đăng xuất & Xóa Session"
        }
      ]
    },
    "scraper": {
      "name": "Hako",
      "description": "Search and read books from Hako.",
      "version": 2,
      "site": {
        "name": "Hako",
        "baseUrl": "https://docln.sbs"
      },
      "capabilities": [
        "search",
        "getBookDetail",
        "getChapter",
        "getFilterOptions",
        "getReviews",
        "getComments",
        "download"
      ],
      "search": {
        "pageSize": 20,
        "fields": [
          {
            "id": "query",
            "type": "text",
            "label": "Từ khóa / Tên truyện"
          },
          {
            "id": "title",
            "type": "text",
            "label": "Tên truyện"
          },
          {
            "id": "author",
            "type": "text",
            "label": "Tác giả"
          },
          {
            "id": "illustrator",
            "type": "text",
            "label": "Họa sĩ"
          },
          {
            "id": "selectgenres",
            "type": "multi-select",
            "label": "Thể loại chọn",
            "optionsMethod": "getFilterOptions"
          },
          {
            "id": "rejectgenres",
            "type": "multi-select",
            "label": "Thể loại loại trừ",
            "optionsMethod": "getFilterOptions"
          },
          {
            "id": "status",
            "type": "select",
            "label": "Tình trạng",
            "defaultValue": "0",
            "options": [
              { "label": "Tất cả", "value": "0" },
              { "label": "Đang tiến hành", "value": "1" },
              { "label": "Tạm ngưng", "value": "2" },
              { "label": "Đã hoàn thành", "value": "3" }
            ]
          },
          {
            "id": "seriestype",
            "type": "select",
            "label": "Loại truyện",
            "defaultValue": "0",
            "options": [
              { "label": "Tất cả", "value": "0" },
              { "label": "Truyện dịch", "value": "1" },
              { "label": "AI dịch", "value": "2" },
              { "label": "Sáng tác", "value": "3" }
            ]
          },
          {
            "id": "sapxep",
            "type": "select",
            "label": "Sắp xếp theo",
            "defaultValue": "az",
            "options": [
              { "label": "Tên A-Z", "value": "az" },
              { "label": "Tên Z-A", "value": "tentruyenza" },
              { "label": "Mới cập nhật", "value": "capnhat" },
              { "label": "Mới đăng", "value": "truyenmoi" },
              { "label": "Lượt xem", "value": "top" },
              { "label": "Top tháng", "value": "topthang" },
              { "label": "Theo dõi", "value": "theodoi" },
              { "label": "Số từ", "value": "sotu" }
            ]
          }
        ]
      }
    }
  }
}
