{
  "name": "hako-scraper",
  "displayName": "Hako",
  "publisher": "hako",
  "version": "0.1.0",
  "description": "Search and read books from Hako.",
  "starter": {
    "kind": "scraper"
  },
  "engines": {
    "enovel": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "browser": "./dist/browser.js",
  "icon": "./public/icon.png",
  "activationEvents": [
    "always"
  ],
  "categories": [
    "Scrapers"
  ],
  "keywords": [
    "e-novels",
    "scraper",
    "typescript"
  ],
  "permissions": [
    "network",
    "reader"
  ],
  "network": {
    "allowedHosts": [
      "docln.sbs"
    ]
  },
  "contributes": {
    "scraper": {
      "name": "Hako",
      "description": "Search and read books from Hako.",
      "version": 2,
      "site": {
        "name": "Hako",
        "baseUrl": "https://docln.sbs"
      },
      "capabilities": [
        "search",
        "getBookDetail",
        "getChapter"
      ],
      "search": {
        "pageSize": 20,
        "fields": [
          {
            "id": "query",
            "type": "text",
            "label": "Search"
          }
        ]
      }
    }
  }
}
